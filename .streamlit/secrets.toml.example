# CareerHub AI - Secrets Configuration Template
# انسخ هذا الملف إلى secrets.toml وضع المفاتيح الخاصة بك

# مفتاح Gemini API الأساسي
GEMINI_API_KEY = "your-gemini-api-key-here"

# إعدادات Supabase السحابية (اختيارية - في حالة عدم توفرها يعمل التطبيق في وضع الزائر Guest Mode)
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-anon-public-key"

# خيارات بيئة التشغيل
APP_ENV = "production"
