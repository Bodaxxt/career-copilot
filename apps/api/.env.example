# ============================================================
# Career Copilot — Backend Environment Variables Example
# apps/api/.env.example
# ============================================================
# انسخ هذا الملف وأعد تسميته إلى .env.development للبيئة المحلية
# لا ترفع ملفات .env الحقيقية على Git أبداً!
# ============================================================

# --- الخادم / Server ---
API_PORT=8000
API_HOST=0.0.0.0
# بيئة التشغيل: development | staging | production
APP_ENV=development

# --- الأمان / Security ---
# مفتاح سري لتشفير JWT — يجب أن يكون طويلاً وعشوائياً
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# --- CORS ---
# الروابط المسموح لها بالوصول للـ API (JSON array)
CORS_ORIGINS=["http://localhost:3000"]

# --- قاعدة البيانات / Database ---
# بيئة التطوير: SQLite (بسيطة)
# DATABASE_URL=sqlite:///./test.db
# بيئة الإنتاج: PostgreSQL (موصى بها)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password@localhost:5432/career_copilot

# بيانات اتصال PostgreSQL (للـ Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=career_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Celery Worker ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- المصادقة (Clerk) / Authentication ---
# مفتاح Clerk السري للتحقق من رموز JWT
# احصل عليه من: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...

# --- الذكاء الاصطناعي / AI Providers ---
# Google Gemini API — احصل عليه من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (اختياري)
OPENAI_API_KEY=sk-...

# --- ChromaDB (Vector Store) ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
