# ============================================================
# Career Copilot — Frontend Environment Variables Example
# apps/web/.env.example
# ============================================================
# انسخ هذا الملف وأعد تسميته إلى .env.development للبيئة المحلية
# أو .env.production للبيئة الإنتاجية
# لا ترفع ملفات .env الحقيقية على Git أبداً!
# ============================================================

# --- التطبيق العام / General ---
# بيئة تشغيل التطبيق
NODE_ENV=development

# رابط الواجهة الأمامية (يظهر للمستخدم)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# رابط الـ API الخلفي
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- المصادقة (Clerk) / Authentication ---
# مفتاح Clerk العلني — يظهر في المتصفح (آمن للنشر)
# احصل عليه من: https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# مفتاح Clerk السري — لا يُعرض للمستخدم أبداً
# احصل عليه من: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=sk_test_...

# روابط إعادة التوجيه بعد تسجيل الدخول/الخروج
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
